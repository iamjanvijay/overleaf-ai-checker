{
  "manifest_version": 3,
  "name": "Overleaf AI Checker",
  "version": "1.0.0",
  "description": "Color-codes your compiled Overleaf PDF by AI-likelihood with Pangram: green = human, red = AI. Download the highlighted PDF.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.overleaf.com/*",
    "https://text.external-api.pangram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Overleaf AI Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
